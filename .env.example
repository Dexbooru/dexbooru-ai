# server settings
SERVER_NAME=dexbooru-ai
SERVER_PORT=8001
ENVIRONMENT=development

ALLOWED_IMAGE_DOMAIN_DESTINATIONS=*

# external service settings

# RabbitMQ settings
AMQP_URL=amqp://guest:supersecret@localhost:5672
PRIMARY_EXCHANGE_NAME=ai_events

# Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# Gemini settings
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-2
GEMINI_OUTPUT_DIMENSIONS=1536

# Postgres settings (POSTGRES_* are used by docker compose)
POSTGRES_USER=dexbooru_ai
POSTGRES_PASSWORD=<your-postgres-password>
DATABASE_URL=postgresql+asyncpg://dexbooru_ai:<your-postgres-password>@localhost:5433/dexbooru_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis settings (REDIS_PASSWORD is used by docker compose)
REDIS_PASSWORD=<your-redis-password>
REDIS_URL=redis://:<your-redis-password>@localhost:6380/0
REDIS_MAX_CONNECTIONS=20

# Replication settings (UPSTREAM_DATABASE_URL is only used by the replica setup script)
# UPSTREAM_DATABASE_URL=postgresql://<user>:<password>@<dexbooru-web-db-host>:5432/<dexbooru-web-db-name>
REPLICATION_PUBLICATION=dexbooru_ai_content
REPLICATION_SUBSCRIPTION=dexbooru_ai_content_sub
REPLICATION_SLOT=dexbooru_ai_content_slot

# Auth settings (JWT_SECRET must match dexbooru-web's JWT_PRIVATE_KEY)
JWT_SECRET=<your-jwt-secret>
# JWT_ISSUER=<your-jwt-issuer>
# JWT_AUDIENCE=<your-jwt-audience>
APP_DOMAIN=localhost
TRUSTED_PROXY_IPS=

# Chat model settings (any OpenAI-compatible endpoint)
CHAT_MODEL_BASE_URL=<your-chat-model-base-url>
CHAT_MODEL_API_KEY=<your-chat-model-api-key>
CHAT_MODEL_NAME=<your-chat-model-name>
CHAT_MODEL_TIMEOUT_SECONDS=60
CHAT_REQUEST_LIMIT=8
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_MAX_MESSAGE_CHARS=2000

# Chat rate limits and quotas
CHAT_USER_MESSAGES_PER_MINUTE=6
CHAT_IP_MESSAGES_PER_MINUTE=20
CHAT_USER_READS_PER_MINUTE=60
AUTH_IP_REQUESTS_PER_MINUTE=10
CHAT_DAILY_THREAD_LIMIT=10
CHAT_DAILY_MESSAGE_LIMIT=100
CHAT_DAILY_TOKEN_LIMIT=200000
CHAT_THREAD_MESSAGE_LIMIT=40

# Image settings
CDN_BASE_URL=http://localhost:4566
IMAGE_RESIZE_WIDTH=512
IMAGE_RESIZE_HEIGHT=512

# ML (Danbooru tag-rating predictor)
DANBOORU_TAG_RATING_SKOPS_PATH=models/danbooru_tag_rating_predictor.skops
SPACY_ENGLISH_MODEL=en_core_web_md
